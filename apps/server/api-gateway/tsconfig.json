{
  "extends": "@neuralpay/config/tsconfig.base.json",
  "compilerOptions": {
    // No `composite`/declaration emit: nothing consumes this project's .d.ts
    // (consumers import ./src/router.ts directly via package exports), and
    // declaration emit is what triggers TS2883 on tRPC tracked() subscriptions.
    "declaration": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
