{
  "name": "@neuralpay/ai-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./routers": {
      "default": "./src/routers/index.ts"
    },
    ".": {
      "default": "./src/app.ts"
    }
  },
  "main": "./src/app.ts",
  "scripts": {
    "dev": "PORT=4003 bun run --hot src/app.ts",
    "build": "tsup",
    "start": "node dist/app.js",
    "check-types": "tsc -b"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/groq": "^3.0.41",
    "@ai-sdk/huggingface": "^2.0.30",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@neuralpay/auth": "workspace:*",
    "@neuralpay/config": "workspace:*",
    "@neuralpay/db": "workspace:*",
    "@neuralpay/env": "workspace:*",
    "@neuralpay/types": "workspace:*",
    "@openrouter/ai-sdk-provider": "^2.9.1",
    "@trpc/server": "catalog:",
    "ai": "^7.0.64",
    "cors": "catalog:",
    "date-fns": "catalog:",
    "drizzle-orm": "catalog:",
    "express": "catalog:",
    "helmet": "catalog:",
    "morgan": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/morgan": "catalog:",
    "@types/cors": "catalog:",
    "@types/bun": "catalog:",
    "@types/express": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
